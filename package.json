{
  "name": "runql-mssql",
  "displayName": "RunQL Microsoft SQL Server Connector",
  "description": "Optional Microsoft SQL Server connector for RunQL.",
  "publisher": "runql",
  "icon": "media/icon.png",
  "version": "1.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DVCodeLabs/RunQL-MSSQL.git"
  },
  "bugs": {
    "url": "https://github.com/DVCodeLabs/RunQL-MSSQL/issues"
  },
  "homepage": "https://runql.com/opensource/",
  "keywords": [
